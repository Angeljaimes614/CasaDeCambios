# Plantilla de variables de entorno. Copia este archivo a `.env` y rellena
# con los valores reales de tu proyecto Supabase. NUNCA subas `.env` al repo.

# URL del proyecto (Settings → API → Project URL)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable key (Settings → API → publishable key, formato sb_publishable_*)
# Es seguro tenerla en el cliente: respeta las políticas RLS.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxx
